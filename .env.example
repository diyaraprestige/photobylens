# Copy to .env (local / VPS) or add in your host's Environment Variables panel.

# AI retouch runs on each visitor's own free Gemini key, entered in their browser.
# Nothing to configure here for AI.

# HD payments via Stripe Checkout (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
# HD price in the smallest currency unit: RM9.90 = 990. Leave 0 until you decide the price.
HD_PRICE_SEN=0
CURRENCY=MYR

# Your live address, used for the return link after payment
SITE_URL=https://photobylens.com
PORT=3000
